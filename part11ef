
# ============================================================
# STEP 11.6: DETECTION RECONCILIATION AND WARNING AUDIT
# ============================================================

import pandas as pd
import numpy as np

audit = evaluated.copy()

for col in ["EVENT", "WARNING", "WARNING_START",
            "EVENT_TIME", "LEAD_TIME"]:
    audit[col] = pd.to_numeric(audit[col], errors="coerce")

# ------------------------------------------------------------
# 1. CLASSIFY ALL EPISODES
# ------------------------------------------------------------

conditions = [
    (audit.EVENT == 1) & (audit.WARNING == 1),
    (audit.EVENT == 1) & (audit.WARNING == 0),
    (audit.EVENT == 0) & (audit.WARNING == 1),
    (audit.EVENT == 0) & (audit.WARNING == 0)
]

labels = [
    "DETECTED_REPLACEMENT",
    "MISSED_REPLACEMENT",
    "CENSORED_WITH_WARNING",
    "CENSORED_WITHOUT_WARNING"
]

audit["OUTCOME"] = np.select(
    conditions, labels, default="UNKNOWN"
)

print("=" * 70)
print("STEP 11.6: EPISODE OUTCOME SUMMARY")
print("=" * 70)

display(
    audit["OUTCOME"].value_counts()
    .rename_axis("OUTCOME")
    .to_frame("EPISODES")
)

# ------------------------------------------------------------
# 2. CALCULATE TRUE REPLACEMENT DETECTION RATE
# ------------------------------------------------------------

replacement = audit[audit.EVENT == 1].copy()

detected = replacement[replacement.WARNING == 1]
missed = replacement[replacement.WARNING == 0]

detection_rate = len(detected) / len(replacement)

print("\nREPLACEMENT PERFORMANCE")
print("-" * 50)

print("Replacement episodes:", len(replacement))
print("Detected:", len(detected))
print("Missed:", len(missed))
print("Detection rate:", round(detection_rate * 100, 2), "%")

# ------------------------------------------------------------
# 3. DISPLAY MISSED REPLACEMENTS
# ------------------------------------------------------------

print("\nMISSED REPLACEMENT EPISODES")

display(
    missed[
        ["EPISODE_ID", "EVENT", "WARNING",
         "WARNING_START", "EVENT_TIME"]
    ].sort_values("EPISODE_ID")
)

# ------------------------------------------------------------
# 4. CENSORED EPISODES WITH WARNINGS
# ------------------------------------------------------------

censored_alerts = audit[
    (audit.EVENT == 0) & (audit.WARNING == 1)
].copy()

print("\nCENSORED EPISODES RECEIVING WARNINGS")

display(
    censored_alerts[
        ["EPISODE_ID", "WARNING_START",
         "EVENT_TIME", "LEAD_TIME"]
    ]
)

# These are unresolved alerts, NOT confirmed false positives.

# ------------------------------------------------------------
# 5. INVESTIGATE EXTREMELY LONG LEAD TIMES
# ------------------------------------------------------------

valid_leads = detected[
    detected.LEAD_TIME.notna() & (detected.LEAD_TIME > 0)
].copy()

print("\nLEAD TIME DISTRIBUTION")

display(
    valid_leads["LEAD_TIME"].describe(
        percentiles=[.10, .25, .50, .75, .90, .95]
    ).to_frame()
)

print("\nTOP 10 EARLIEST WARNINGS")

display(
    valid_leads[
        ["EPISODE_ID", "WARNING_START",
         "EVENT_TIME", "LEAD_TIME"]
    ].sort_values("LEAD_TIME", ascending=False).head(10)
)

# ------------------------------------------------------------
# 6. ESN / MULTIPLE EPISODE REVIEW
# ------------------------------------------------------------

audit["ESN"] = audit["EPISODE_ID"].astype(str).str.replace(
    r"_\d+$", "", regex=True
)

multiple = audit.groupby("ESN").agg(
    EPISODES=("EPISODE_ID", "nunique"),
    REPLACEMENTS=("EVENT", "sum"),
    WARNINGS=("WARNING", "sum")
).reset_index()

print("\nMULTIPLE EPISODE SUMMARY")

print("Unique ESNs:", audit.ESN.nunique())
print("ESNs with multiple episodes:",
      (multiple.EPISODES > 1).sum())

print("\nESNs with multiple replacement events")

display(
    multiple[multiple.REPLACEMENTS > 1]
    .sort_values("REPLACEMENTS", ascending=False)
)

# ------------------------------------------------------------
# 7. FINAL RECONCILIATION
# ------------------------------------------------------------

print("\n" + "=" * 70)
print("FINAL RECONCILIATION")
print("=" * 70)

print("Total episodes:", len(audit))
print("Actual replacements:", len(replacement))
print("Detected replacements:", len(detected))
print("Missed replacements:", len(missed))
print("Censored alerts:", len(censored_alerts))
print("Detection rate:", round(detection_rate * 100, 2), "%")

print("\nSTEP 11.6 COMPLETE")
